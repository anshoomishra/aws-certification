# Copy this file to .env and replace only the non-secret settings.
# Do not commit .env or long-lived access keys.

# Recommended: use an AWS CLI/SSO profile instead of access keys.
AWS_PROFILE=default
AWS_REGION=ap-south-1

# Optional for temporary credentials only. Leave blank when AWS_PROFILE is used.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Used by the starter examples for resource ownership and cleanup.
S3_BUCKET_PREFIX=aws-certification-s3-lab
