# Copy to .env at the repository root. The .env file is ignored by Git.
# Prefer AWS CLI SSO or an IAM role over long-lived access keys.

AWS_PROFILE=default
AWS_REGION=ap-south-1

# Optional temporary credentials. Leave these unset when using AWS_PROFILE.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_LAB_PROJECT=aws-certification
AWS_LAB_OWNER=your-name
AWS_LAB_ENVIRONMENT=learning
S3_BUCKET_PREFIX=aws-certification-s3-lab
